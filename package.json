{
  "name": "secure-text-compare",
  "version": "1.0.0",
  "description": "A private local two-pane text comparison app built with Electron.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "diff",
    "text",
    "desktop",
    "developer-tools"
  ],
  "author": "Secure Text Compare contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bvnkame/secure-text-compare.git"
  },
  "homepage": "https://github.com/bvnkame/secure-text-compare#readme",
  "bugs": {
    "url": "https://github.com/bvnkame/secure-text-compare/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.securetextcompare.app",
    "productName": "Secure Text Compare",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "index.html",
      "styles.css",
      "renderer.js"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "pdf-parse": "^2.4.5"
  }
}
